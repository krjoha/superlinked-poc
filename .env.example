# Environment Configuration for Superlinked API
# Copy this file to .env and fill in your values

# ============================================================================
# VECTOR DATABASE CONFIGURATION
# ============================================================================

# Vector database type: inmemory, redis, postgres (future), qdrant (future)
VECTOR_DB_TYPE=redis

# Redis Configuration (when VECTOR_DB_TYPE=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_DB=0

# Redis connection pool settings
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ============================================================================
# DATA LOADING CONFIGURATION
# ============================================================================

# Use test datasets (1k rows) instead of full datasets
USE_TEST_DATA=0

# ============================================================================
# API CONFIGURATION
# ============================================================================

# API authentication key (change in production!)
API_KEY=your_api_key_here

# Server port
SERVER_PORT=8080

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
